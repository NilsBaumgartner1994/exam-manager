{
  "name": "exam-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "yarn workspace @exam-manager/web start:web",
    "export:web": "yarn workspace @exam-manager/web export:web",
    "test": "yarn workspace @exam-manager/core test",
    "typecheck": "yarn workspace @exam-manager/core typecheck && yarn workspace @exam-manager/web typecheck"
  }
}
